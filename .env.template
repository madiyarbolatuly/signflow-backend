# Обязательные переменные
# Без JWT_SECRET_KEY приложение не стартует: pydantic-settings сообщит, какого
# поля не хватает, вместо падения на импорте, как это было в EDMS.
JWT_SECRET_KEY=смените-на-случайную-строку-не-короче-16-символов

# База данных
POSTGRES_USER=signflow
POSTGRES_PASSWORD=смените-пароль
POSTGRES_HOSTNAME=localhost
POSTGRES_PORT=5432
POSTGRES_DB=signflow

# Адрес, относительно которого собираются ссылки подписания. Должен быть
# доступен получателю письма: localhost здесь означает нерабочие ссылки у всех,
# кто открывает почту не на сервере.
FRONTEND_URL=http://localhost:8088

# Срок действия ссылки подписания, суток (ТЗ, п. 5.1.4)
SIGN_LINK_TTL_DAYS=14

# Почта. Пока MAIL_DRY_RUN=true письма только пишутся в журнал и никуда не
# уходят — безопасное значение для разработки.
MAIL_DRY_RUN=true
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=signflow@example.com

# Браузерные источники, которым разрешено обращаться к API. Пусто — берутся
# значения по умолчанию для локальной разработки.
CORS_ORIGINS=

# Файловое хранилище
STORAGE_PATH=./storage

DEBUG=false
